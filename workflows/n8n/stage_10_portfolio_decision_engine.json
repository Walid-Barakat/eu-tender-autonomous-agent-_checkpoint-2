      ],
      "notes": "Connect to the Notion 'Tender Radar' update and Drive archive used in Stage 9. Kept as an explicit hand-off so the approval record is persisted before any downstream write."
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE-WITH-CHANNEL-ID",
          "mode": "id"
        },
        "text": "={{ 'Stage 10 decision engine failed: ' + ($json.error?.message || $json.detail || JSON.stringify($json).slice(0, 300)) }}",
